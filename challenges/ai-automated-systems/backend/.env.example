# Copy to backend/.env (gitignored; Unpack.ps1 does it). Keys come from the team vault: tools/creds/pull-creds.ps1
# Spec: docs/llm-wrapper.md
LLM_MODE=cached            # live | cached | local | off
LLM_PROVIDER=              # live mode: the provider's name, for the log
LLM_MODEL=                 # live mode: the provider's model name
LLM_BASE_URL=http://127.0.0.1:1234/v1   # any OpenAI-compatible /v1 server; default = local phoenix-lai (team standard)
                           # BRIDGEWARDEN_AI_ENDPOINT_URL overrides this; the shared LLM_URL overrides both
                           # Through Fairlead (the model router): LLM_BASE_URL=fairlead finds it wherever it runs
                           # (its CLI file %LOCALAPPDATA%\Fairlead\fairlead-cli.json, or an older Fairlead's FAIRLEAD_HOME\logs\fairlead-server-*.json, else 127.0.0.1:8776). Detected
                           # automatically: key from Credential Manager Fairlead/BridgeWarden (Fairlead > Clients >
                           # install for BridgeWarden; LLM_API_KEY is ignored), header X-Fairlead-Label: BridgeWarden
LLM_LOCAL_MODEL=           # blank on a loopback URL = "phoenixlai" ("local" route on Fairlead); elsewhere = first at /v1/models
LLM_API_KEY=local          # Bearer token; on loopback "local" or blank sends no header. Remote URLs need https + a key
                           # The three picture deciders (TAO, EOOW, DCO) always ask the model; with no answer in
                           # policies.json reflex_deadline_s, urgent alerts get the lookout's doctrine option (Warden checks it).
LLM_AGENT=on               # free-form model path (a compromised agent in the Warden Tests): on = it asks the model
LLM_AGENT_HEARTBEAT_S=45   # free-form path: ask again after this long even if nothing changed
LLM_AGENT_MIN_GAP_S=6      # free-form path: never ask one agent more often than this
LLM_PARALLEL=1             # free-form path: concurrent model calls
LLM_TIMEOUT_S=3            # text features (summaries); raise to 15-30 for remote or thinking models. Explain allows 30 s.
LLM_MAX_TOKENS=400
LLM_RECORD=0               # 1 = save live/local answers to fixtures/llm_cache.json
LLM_REASONING_EFFORT=     # none | low | medium | high, for thinking models (Gemini 3.x, o-series); blank = not sent
LLM_INCLUDE_THOUGHTS=0    # 1 = ask Gemini for thought summaries (shown under Thinking in Explain)
# <PROVIDER>_API_KEY=      # e.g. OPENAI_API_KEY, XAI_API_KEY; pulled from the vault, never committed
